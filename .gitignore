/laptop/labview/**/*.llb
/laptop/labview/**/*.dll
/laptop/labview/**/*.so
/laptop/labview/**/*.so.*
/laptop/labview/**/*.dylib
/laptop/labview/**/*.exe
/laptop/labview/**/*.aliases
/laptop/labview/**/*.lvlps
/laptop/labview/**/*.lvprojstate
/laptop/labview/**/*.UserState
/laptop/labview/**/.cache/
/laptop/labview/Builds/
/laptop/labview/screenshots/*
!/laptop/labview/screenshots/.gitkeep
